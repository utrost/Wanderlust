# Rust
/target
**/*.rs.bk

# Flutter / Dart
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
# Generated per-platform scaffolding (recreated via `flutter create` — see app/README.md)
app/android/
app/ios/
app/linux/
app/macos/
app/windows/
app/web/

# Tile pipeline build artifacts (regenerated from OSM extracts)
tools/out/

# Tooling / OS
.DS_Store
*.log

# Python tooling
__pycache__/

# Generated Flutter project metadata / IDE files
app/.gitignore
app/.metadata
app/.idea/
app/*.iml

# Persistent APK signing material: never commit or publish private keys.
.local/signing/
*.keystore
*.jks

# Local release signing configuration (credentials come from environment).
key.properties
